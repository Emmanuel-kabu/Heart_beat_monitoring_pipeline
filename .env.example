# .env.example - Copy this to .env and fill in your values

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=heartbeat_db
POSTGRES_USER=heartbeat_user
POSTGRES_PASSWORD=heartbeat_pass123

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=customer_heartbeat
KAFKA_GROUP_ID=heartbeat_consumer_group
KAFKA_AUTO_OFFSET_RESET=earliest

# Data Generator Configuration
NUM_CUSTOMERS=10
GENERATION_INTERVAL_SEC=1.0
HEART_RATE_MIN=40
HEART_RATE_MAX=200
NORMAL_HEART_RATE_MIN=60
NORMAL_HEART_RATE_MAX=100

# Anomaly Thresholds
ANOMALY_LOW_THRESHOLD=50
ANOMALY_HIGH_THRESHOLD=150

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log

# Streamlit Dashboard
DASHBOARD_REFRESH_INTERVAL=5
DASHBOARD_PORT=8501

# ─── Prometheus Monitoring ──────────────────────────────────────────────────
PROMETHEUS_METRICS_PORT=8000

# ─── Edge-Case Detection Thresholds ────────────────────────────────────────
HEARTBEAT_DELAY_THRESHOLD_SEC=30
DEVICE_FAILURE_THRESHOLD_SEC=120
SPIKE_DELTA_THRESHOLD=40
SUSTAINED_ANOMALY_COUNT=5
SUSTAINED_ANOMALY_WINDOW_MIN=10
EDGE_CHECK_INTERVAL_SEC=15
DLQ_ALERT_THRESHOLD=100

# ─── Slack Alerting ────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_DAILY_WEBHOOK_URL=
SLACK_DAILY_CHANNEL=
SLACK_WEEKLY_WEBHOOK_URL=
SLACK_WEEKLY_CHANNEL=

# ─── Email Alerting (critical issues + monthly reports) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENTS=

# ─── Data Quality (Great Expectations) ─────────────────────────────────────
DQ_ENABLED=true
DQ_MAX_RETRIES=3
DQ_CIRCUIT_BREAKER_THRESHOLD=0.5
DQ_TIMELINESS_MAX_AGE_SEC=300
DQ_TIMELINESS_FUTURE_TOLERANCE_SEC=30
DQ_DEGRADATION_EMAIL_THRESHOLD=80.0
